{
  "name": "personal-expenses-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fallow": "node scripts/check-fallow.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run fallow && npm run check:docs && npm run build && npm run test:e2e",
    "harness": "node scripts/harness.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^3.31.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1"
  }
}
