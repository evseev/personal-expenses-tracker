{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "digest": { "type": "string" },
    "findings": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  },
  "required": ["status", "digest", "findings", "summary"]
}
